@model PAW.Models.DTO.NotificationDTO
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="Save" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit" : "Add") Notification</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User ID</label>
            <input asp-for="UserId" type="number" step="1" class="form-control" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Message" class="form-label">Message</label>
            <textarea asp-for="Message" class="form-control" rows="3" maxlength="255"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IsRead" class="form-label">Read</label>
            <select name="IsRead" id="IsRead" class="form-select">
            <option value="true" selected="@(Model.IsRead == true)">Yes</option>
            <option value="false" selected="@(Model.IsRead != true)">No</option>
        </select>
            <span asp-validation-for="IsRead" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
