@model PAW.Web.Models.DeleteConfirmModel

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">Delete @Model.Entity</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <p class="mb-0">
            Are you sure you want to delete <strong>@Model.Summary</strong>? This action cannot be undone.
        </p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
