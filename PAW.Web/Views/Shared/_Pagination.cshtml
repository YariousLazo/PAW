@model PAW.Web.Models.IPagedList
@{
    // Format: <<  <  ... before, "current", next ...  >  >>
    var current = Model.Page;
    var last = Model.TotalPages;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var firstItem = Model.TotalItems == 0 ? 0 : ((current - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(current * Model.PageSize, Model.TotalItems);

    string PageUrl(int p) => Url.Action(action, new { page = p }) ?? "#";
}

<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <small class="text-muted">Showing @firstItem to @lastItem of @Model.TotalItems</small>

    @if (last > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm mb-0">

                <!-- First -->
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(1)" aria-label="First">&lt;&lt;</a>
                </li>

                <!-- Previous -->
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Math.Max(1, current - 1))" aria-label="Previous">&lt;</a>
                </li>

                <!-- ... before -->
                @if (current - 1 > 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                @if (current > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(current - 1)">@(current - 1)</a></li>
                }

                <!-- Current -->
                <li class="page-item active" aria-current="page"><span class="page-link">@current</span></li>

                <!-- after ... -->
                @if (current < last)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(current + 1)">@(current + 1)</a></li>
                }
                @if (current + 1 < last)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                <!-- Next -->
                <li class="page-item @(current == last ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Math.Min(last, current + 1))" aria-label="Next">&gt;</a>
                </li>

                <!-- Last -->
                <li class="page-item @(current == last ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(last)" aria-label="Last">&gt;&gt;</a>
                </li>

            </ul>
        </nav>
    }
</div>
