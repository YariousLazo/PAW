@model PAW.Models.DTO.RoleDTO
@{
    var isEdit = Model.RoleId > 0;
}

<form asp-action="Save" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit" : "Add") Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="RoleId" />

        <div class="mb-3">
            <label asp-for="RoleName" class="form-label">Name</label>
            <input asp-for="RoleName" class="form-control" maxlength="255" />
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
