@*
    Floating exchange-rate card (top right).
    It has no model: the values are loaded and cached by site.js (getExchangeRate / loadExchangeRate).
    It is rendered once from _Layout, so it shows on every page.
*@

<aside id="exchangeRateWidget" class="fx-widget is-loading" aria-label="Exchange rate" aria-live="polite">
    <div class="fx-header">
        <span class="fx-title">Exchange Rate</span>
        <div class="fx-actions">
            <button type="button" id="fxRefresh" class="fx-btn" title="Refresh" aria-label="Refresh exchange rate">&#8635;</button>
            <button type="button" id="fxToggle" class="fx-btn" title="Minimize" aria-expanded="true" aria-label="Minimize or expand">&minus;</button>
        </div>
    </div>

    <div class="fx-body">
        <div class="fx-block">
            <div class="fx-currency">
                <span class="fx-badge fx-usd">USD</span>
                <span class="fx-date" id="fxUsdDate"></span>
            </div>
            <div class="fx-row"><span>Buy</span><strong id="fxUsdBuy">&hellip;</strong></div>
            <div class="fx-row"><span>Sell</span><strong id="fxUsdSell">&hellip;</strong></div>
        </div>

        <div class="fx-block">
            <div class="fx-currency">
                <span class="fx-badge fx-eur">EUR</span>
                <span class="fx-date" id="fxEurDate"></span>
            </div>
            <div class="fx-row"><span>Colones</span><strong id="fxEurColones">&hellip;</strong></div>
            <div class="fx-row"><span>Dollars</span><strong id="fxEurDollars">&hellip;</strong></div>
        </div>

        <div class="fx-status" id="fxStatus">Loading&hellip;</div>
    </div>
</aside>
